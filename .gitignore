*pro.user


**/.vs/
build/
config.tests/*/.qmake.stash
config.tests/*/Makefile

# Staged installer payload and generated installer inputs. scripts\build-seathub.ps1 writes these
# from the deploy folder every run; they are build output, not sources.
installer/packages/*/data/
installer/packages/*/meta/license.txt
installer/config/seathub.ico

# Test build output. The suites are built in place (`qmake <suite>.pro && jom` inside tests/), so
# the generated Makefile, moc/object files, binaries and any `-o <suite>-out.txt` report land beside
# the sources. tests/ is entirely this fork's (upstream ships no test tree).
tests/Makefile
tests/.qmake.stash
tests/target_wrapper.bat
tests/*.obj
tests/*.exe
tests/*.moc
tests/moc_*
tests/qrc_*
tests/*-out.txt
